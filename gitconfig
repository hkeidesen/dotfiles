[alias]
  # Short status and log
  s = status -sb
  l = log --oneline --graph --decorate
  lg = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'

  # GitHub-focused
  co = checkout
  cob = checkout -b
  cm = commit -m
  amend = commit --amend --no-edit
  aa = add --all
  p = push
  pf = push --force-with-lease
  pl = pull --rebase

  # Clean up branches
  cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master' | xargs -n 1 git branch -d"
  gone = "!git remote prune origin && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D"

  # Open GitHub repo in browser (requires GitHub remote)
  open = "!open $(git remote get-url origin | sed 's/git@github.com:/https:\\/\\/github.com\\//;s/.git$//')"

  # Last commit diff
  last = "!git show --stat --oneline HEAD"

  # Interactively pick commits to reword or squash
  fixup = "!f() { git commit --fixup=$1 && git rebase -i --autosquash $1^; }; f"

  # Rebase with autosquash to clean history
  squash = "!git rebase -i --autosquash HEAD~5"
  d = diff --color-words
  ds = difftool --tool=vimdiff
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
# Route every github.com remote over HTTPS so it goes through the gh credential
# helper above, which serves whichever account scripts/gh-auth.zsh selected for
# this shell. One auth path for git and gh, instead of SSH quietly using a
# single global key regardless of which client's repo you're standing in.
# The stored URL is untouched (`git config --get remote.origin.url` still shows
# what was cloned); `git remote -v` and the transport both show the rewrite.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
	insteadOf = git@github-sopra:

# Commit identity, keyed on the same orgs as _GH_ORG_ACCOUNTS in
# scripts/gh-auth.zsh. Two patterns per org on purpose: "**org/**" matches the
# scp-style form (git@github.com:org/repo — no slash before the org), and
# "**/org/**" matches https:// and ssh:// (where there is one). A single "**"
# only crosses "/" when it is a whole path component, so neither pattern covers
# both forms on its own.
[includeIf "hasconfig:remote.*.url:**Trondheim-kommune-tip/**"]
	path = ~/dotfiles/gitconfig-sopra
[includeIf "hasconfig:remote.*.url:**/Trondheim-kommune-tip/**"]
	path = ~/dotfiles/gitconfig-sopra
[includeIf "hasconfig:remote.*.url:**dfo-no/**"]
	path = ~/dotfiles/gitconfig-dfo
[includeIf "hasconfig:remote.*.url:**/dfo-no/**"]
	path = ~/dotfiles/gitconfig-dfo
